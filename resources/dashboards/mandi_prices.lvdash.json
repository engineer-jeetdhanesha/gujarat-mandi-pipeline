{
  "datasets": [
    {
      "name": "trend",
      "displayName": "Average price by week",
      "queryLines": [
        "WITH latest AS (SELECT MAX(week_start) AS latest_week FROM mart_price_weekly WHERE is_complete_week),\n",
        "periods AS (SELECT CASE :period WHEN 'Current week' THEN 0 WHEN 'Last 2 weeks' THEN 1 WHEN 'Last month' THEN 3 ELSE 12 END AS weeks_back)\n",
        "SELECT w.week_start, AVG(w.avg_modal_price) AS avg_price\n",
        "FROM mart_price_weekly w CROSS JOIN latest CROSS JOIN periods\n",
        "WHERE w.is_complete_week AND w.commodity_name = :commodity\n",
        "  AND w.week_start >= date_sub(latest.latest_week, 7 * periods.weeks_back)\n",
        "GROUP BY w.week_start\n",
        "ORDER BY w.week_start"
      ],
      "parameters": [
        {
          "displayName": "commodity",
          "keyword": "commodity",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Wheat"
                }
              ]
            }
          }
        },
        {
          "displayName": "period",
          "keyword": "period",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Last 3 months"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "extremes",
      "displayName": "Highest and lowest 5 districts",
      "queryLines": [
        "WITH latest AS (SELECT MAX(week_start) AS latest_week FROM mart_price_weekly WHERE is_complete_week),\n",
        "periods AS (SELECT CASE :period WHEN 'Current week' THEN 0 WHEN 'Last 2 weeks' THEN 1 WHEN 'Last month' THEN 3 ELSE 12 END AS weeks_back),\n",
        "by_district AS (\n",
        "  SELECT w.district_name, AVG(w.avg_modal_price) AS avg_price\n",
        "  FROM mart_price_weekly w CROSS JOIN latest CROSS JOIN periods\n",
        "  WHERE w.is_complete_week AND w.commodity_name = :commodity\n",
        "    AND w.week_start >= date_sub(latest.latest_week, 7 * periods.weeks_back)\n",
        "  GROUP BY w.district_name\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT district_name, avg_price,\n",
        "    ROW_NUMBER() OVER (ORDER BY avg_price DESC) AS rank_high,\n",
        "    ROW_NUMBER() OVER (ORDER BY avg_price ASC) AS rank_low\n",
        "  FROM by_district\n",
        "),\n",
        "picked AS (\n",
        "  SELECT district_name, avg_price,\n",
        "    CASE WHEN rank_high <= 5 THEN 'Highest 5' ELSE 'Lowest 5' END AS price_group,\n",
        "    rank_high AS sort_order\n",
        "  FROM ranked WHERE rank_high <= 5 OR rank_low <= 5\n",
        ")\n",
        "SELECT district_name, avg_price, price_group FROM (\n",
        "  SELECT * FROM picked\n",
        "  UNION ALL SELECT ' ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1001 AS sort_order UNION ALL SELECT '  ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1002 AS sort_order UNION ALL SELECT '   ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1003 AS sort_order UNION ALL SELECT '    ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1004 AS sort_order UNION ALL SELECT '     ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1005 AS sort_order UNION ALL SELECT '      ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1006 AS sort_order UNION ALL SELECT '       ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1007 AS sort_order UNION ALL SELECT '        ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1008 AS sort_order UNION ALL SELECT '         ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1009 AS sort_order UNION ALL SELECT '          ' AS district_name, CAST(NULL AS DOUBLE) AS avg_price, 'Lowest 5' AS price_group, 1010 AS sort_order\n",
        ")\n",
        "ORDER BY sort_order\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "commodity",
          "keyword": "commodity",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Wheat"
                }
              ]
            }
          }
        },
        {
          "displayName": "period",
          "keyword": "period",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Last 3 months"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "commodity_options",
      "displayName": "Commodity list",
      "queryLines": [
        "SELECT DISTINCT commodity_name\n",
        "FROM mart_price_weekly"
      ]
    },
    {
      "name": "period_options",
      "displayName": "Period list",
      "queryLines": [
        "SELECT * FROM VALUES ('Current week', 1), ('Last 2 weeks', 2), ('Last month', 3), ('Last 3 months', 4)\n",
        "AS p(period, sort_order)"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Mandi prices",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          },
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# Gujarat mandi prices\n",
                "Weekly average modal price in rupees per quintal, complete weeks only. Pick a commodity and a period; all three charts follow. Periods count back from the latest complete week, and each price is the average of the district weekly averages."
              ]
            }
          }
        },
        {
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 2
          },
          "widget": {
            "name": "f_commodity",
            "queries": [
              {
                "name": "q_options",
                "query": {
                  "datasetName": "commodity_options",
                  "fields": [
                    {
                      "name": "commodity_name",
                      "expression": "`commodity_name`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "p_trend",
                "query": {
                  "datasetName": "trend",
                  "parameters": [
                    {
                      "name": "commodity",
                      "keyword": "commodity"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "p_extremes",
                "query": {
                  "datasetName": "extremes",
                  "parameters": [
                    {
                      "name": "commodity",
                      "keyword": "commodity"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-single-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "commodity_name",
                    "displayName": "Commodity",
                    "queryName": "q_options"
                  },
                  {
                    "parameterName": "commodity",
                    "queryName": "p_trend"
                  },
                  {
                    "parameterName": "commodity",
                    "queryName": "p_extremes"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Commodity"
              }
            }
          }
        },
        {
          "position": {
            "x": 3,
            "y": 2,
            "width": 3,
            "height": 2
          },
          "widget": {
            "name": "f_period",
            "queries": [
              {
                "name": "q_options",
                "query": {
                  "datasetName": "period_options",
                  "fields": [
                    {
                      "name": "period",
                      "expression": "`period`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "p_trend",
                "query": {
                  "datasetName": "trend",
                  "parameters": [
                    {
                      "name": "period",
                      "keyword": "period"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "p_extremes",
                "query": {
                  "datasetName": "extremes",
                  "parameters": [
                    {
                      "name": "period",
                      "keyword": "period"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-single-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "period",
                    "displayName": "Period",
                    "queryName": "q_options"
                  },
                  {
                    "parameterName": "period",
                    "queryName": "p_trend"
                  },
                  {
                    "parameterName": "period",
                    "queryName": "p_extremes"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Period"
              }
            }
          }
        },
        {
          "position": {
            "x": 0,
            "y": 4,
            "width": 6,
            "height": 6
          },
          "widget": {
            "name": "c_trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "trend",
                  "fields": [
                    {
                      "name": "week_start",
                      "expression": "`week_start`"
                    },
                    {
                      "name": "avg_price",
                      "expression": "`avg_price`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "week_start",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Week starting"
                },
                "y": {
                  "fieldName": "avg_price",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Average modal price (Rs per quintal)"
                }
              },
              "mark": {
                "colors": [
                  "#2a78d6"
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Average modal price by week",
                "showDescription": true,
                "description": "Shows whether the price of the chosen commodity is rising, falling or steady from week to week."
              }
            }
          }
        },
        {
          "position": {
            "x": 0,
            "y": 10,
            "width": 6,
            "height": 9
          },
          "widget": {
            "name": "c_districts",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "extremes",
                  "fields": [
                    {
                      "name": "district_name",
                      "expression": "`district_name`"
                    },
                    {
                      "name": "avg_price",
                      "expression": "`avg_price`"
                    },
                    {
                      "name": "price_group",
                      "expression": "`price_group`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "district_name",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
                    }
                  },
                  "displayName": "District"
                },
                "y": {
                  "fieldName": "avg_price",
                  "scale": {
                    "type": "quantitative",
                    "domain": {
                      "min": 0
                    }
                  },
                  "displayName": "Average modal price (Rs per quintal)"
                },
                "color": {
                  "fieldName": "price_group",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {
                        "value": "Highest 5",
                        "color": "#2a78d6"
                      },
                      {
                        "value": "Lowest 5",
                        "color": "#eb6834"
                      }
                    ]
                  },
                  "displayName": "Price group"
                },
                "label": {
                  "show": true
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Highest and lowest 5 districts by average modal price",
                "showDescription": true,
                "description": "Shows the districts where the chosen commodity sells for the most (blue) and for the least (orange)."
              }
            }
          }
        }
      ]
    }
  ]
}