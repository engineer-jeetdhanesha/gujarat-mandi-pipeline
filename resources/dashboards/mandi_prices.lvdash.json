{
  "datasets": [
    {
      "name": "weekly",
      "displayName": "Weekly prices",
      "queryLines": [
        "SELECT week_start, district_name, commodity_name, category, avg_modal_price, min_price, max_price, wow_change_pct, markets_count, price_records\n",
        "FROM mart_price_weekly"
      ]
    },
    {
      "name": "latest",
      "displayName": "Latest week",
      "queryLines": [
        "SELECT week_start, district_name, commodity_name, category, avg_modal_price, min_price, max_price, wow_change_pct, markets_count, price_records\n",
        "FROM mart_price_weekly\n",
        "WHERE week_start = (SELECT MAX(week_start) FROM mart_price_weekly)"
      ]
    },
    {
      "name": "movers",
      "displayName": "Biggest weekly movers",
      "queryLines": [
        "SELECT * FROM (\n",
        "  (SELECT commodity_name, ROUND(AVG(wow_change_pct), 1) AS change_pct, 'Rise' AS direction\n",
        "   FROM mart_price_weekly\n",
        "   WHERE week_start = (SELECT MAX(week_start) FROM mart_price_weekly) AND wow_change_pct IS NOT NULL\n",
        "   GROUP BY commodity_name HAVING AVG(wow_change_pct) > 0 ORDER BY change_pct DESC LIMIT 5)\n",
        "  UNION ALL\n",
        "  (SELECT commodity_name, ROUND(AVG(wow_change_pct), 1) AS change_pct, 'Fall' AS direction\n",
        "   FROM mart_price_weekly\n",
        "   WHERE week_start = (SELECT MAX(week_start) FROM mart_price_weekly) AND wow_change_pct IS NOT NULL\n",
        "   GROUP BY commodity_name HAVING AVG(wow_change_pct) < 0 ORDER BY change_pct ASC LIMIT 5)\n",
        ")"
      ]
    }
  ],
